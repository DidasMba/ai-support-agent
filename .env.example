# Copy to .env and fill in. Never commit .env

# Option A (recommended): Gemini Enterprise Agent Platform (formerly Vertex AI).
# Authenticates with Application Default Credentials; no API key needed.
# Locally, run once: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
# Only if your embedding model lives in another location than the chat model:
# EMBEDDING_LOCATION=us-central1

# Option B: Gemini Developer API with a free key from aistudio.google.com/apikey.
# Used only when GOOGLE_CLOUD_PROJECT is not set.
# GEMINI_API_KEY=your-key

# Optional overrides (defaults live in app/config.py)
# BUSINESS_NAME=Kigali Central Pharmacy
# CHAT_MODEL=gemini-3.6-flash
# EMBEDDING_MODEL=gemini-embedding-001
# TOP_K=3
# MIN_SCORE=0.3
# GEMINI_TIMEOUT=20
# MAX_MESSAGE_CHARS=1000
# MAX_HISTORY_TURNS=6
# LOG_LEVEL=INFO
